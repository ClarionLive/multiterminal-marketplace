{
  "description": "MultiTerminal lifecycle, safety, and coordination hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/project-context-hook.js"
            ],
            "timeout": 6
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-Command",
              "Write-Output @'\nPARALLEL SUBAGENTS: ALWAYS use the Task tool to spawn subagents for non-trivial work. Launch multiple subagents IN PARALLEL (single message, multiple Task calls) whenever tasks are independent. Examples: exploring multiple directories, researching different topics, implementing separate features, running builds and tests. Prefer subagents over doing work directly - they reduce context usage and run concurrently. When planning implementation, break work into parallelizable chunks and dispatch subagents simultaneously.\n'@"
            ],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-status-hook.js"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-compact-hook.js"
            ],
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-status-hook.js"
            ],
            "async": false
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "SessionEnd",
              "sync"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PreToolUse",
              "sync"
            ],
            "timeout": 130
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PreToolUse",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PostToolUse",
              "sync"
            ],
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PostToolUse",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PostToolUseFailure",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "PreCompact",
              "sync"
            ],
            "timeout": 8
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "Elicitation",
              "sync"
            ],
            "timeout": 130
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "Stop",
              "sync"
            ],
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "Stop",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "SubagentStart",
              "sync"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "SubagentStart",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "SubagentStop",
              "sync"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "SubagentStop",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "TeammateIdle",
              "sync"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "UserPromptSubmit",
              "sync"
            ],
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "UserPromptSubmit",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.js",
              "Notification",
              "async"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
